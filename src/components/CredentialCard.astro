---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  viewerIndex: number;
  kind: 'Certification' | 'Course completion';
  title: string;
  provider: string;
  dateLabel: string;
  image?: ImageMetadata;
  badgeImage?: ImageMetadata;
  status?: 'completed' | 'in-progress';
  eager?: boolean;
}

const {
  viewerIndex,
  kind,
  title,
  provider,
  dateLabel,
  image,
  badgeImage,
  status = 'completed',
  eager = false,
} = Astro.props;
const itemNumber = String(viewerIndex + 1).padStart(2, '0');
const actionLabel = status === 'in-progress' ? 'View course progress' : 'View certificate';
---

<article class:list={["credential-card", { 'credential-card--pending': status === 'in-progress' }]}>
  <button
    class="credential-card__media"
    type="button"
    data-viewer-open={viewerIndex}
    data-viewer-title={title}
    aria-label={`${actionLabel}: ${title}`}
  >
    {image ? (
      <Image
        src={image}
        alt={`Certificate for ${title}`}
        widths={[420, 720]}
        sizes="(max-width: 48rem) 92vw, (max-width: 75rem) 44vw, 28rem"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="credential-card__pending-visual" aria-hidden="true">
        <strong>In progress</strong>
        <span>Certificate pending</span>
      </span>
    )}
    {badgeImage && (
      <span class="credential-card__badge" aria-hidden="true">
        <Image src={badgeImage} alt="" widths={[96, 160]} sizes="5rem" loading="lazy" />
      </span>
    )}
    <span class="credential-card__number" aria-hidden="true">{itemNumber}</span>
    <span class="credential-card__open" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
    </span>
  </button>

  <div class="credential-card__body">
    <div class="credential-card__meta">
      <span>{kind}</span>
      <span class:list={{ 'is-active': status === 'in-progress' }}>
        {status === 'in-progress' ? 'In progress' : dateLabel}
      </span>
    </div>
    <h2>
      <button type="button" data-viewer-open={viewerIndex} data-viewer-title={title}>
        {title}
      </button>
    </h2>
    <p>{provider}</p>
    <button
      class="credential-card__action"
      type="button"
      data-viewer-open={viewerIndex}
      data-viewer-title={title}
    >
      <span>{actionLabel}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
    </button>
  </div>
</article>

<style>
  .credential-card {
    min-width: 0;
  }

  .credential-card__media {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1.48 / 1;
    padding: 0;
    overflow: hidden;
    place-items: center;
    border: 0.34rem solid var(--color-black);
    border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    background: var(--color-surface);
    color: var(--color-white);
    clip-path: polygon(0 0, calc(100% - 2.8rem) 0, 100% 2.8rem, 100% 100%, 2.8rem 100%, 0 calc(100% - 2.8rem));
    cursor: pointer;
  }

  .credential-card__media::after {
    position: absolute;
    inset: 0;
    border: 0.18rem solid transparent;
    background: linear-gradient(150deg, transparent 54%, rgb(0 0 0 / 0.44));
    content: '';
    pointer-events: none;
  }

  .credential-card__media :global(> img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-white);
    transition: transform var(--motion-slow) ease;
  }

  .credential-card:hover .credential-card__media :global(> img),
  .credential-card:focus-within .credential-card__media :global(> img) {
    transform: scale(1.025);
  }

  .credential-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: grid;
    width: clamp(3.7rem, 7vw, 5.2rem);
    aspect-ratio: 1;
    padding: 0.32rem;
    place-items: center;
    border: 0.16rem solid var(--color-black);
    border-radius: 50%;
    background: var(--color-white);
    box-shadow: 0.22rem 0.22rem 0 var(--color-lime);
  }

  .credential-card__badge :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .credential-card__number {
    position: absolute;
    right: 0.75rem;
    bottom: 0.4rem;
    z-index: 2;
    color: var(--color-lime);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    font-style: italic;
    letter-spacing: -0.05em;
    line-height: 0.8;
    text-shadow: 0.12rem 0.12rem 0 var(--color-black);
  }

  .credential-card__open {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 2;
    display: grid;
    width: 2.4rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--color-black);
    color: var(--color-white);
  }

  .credential-card__open svg {
    width: 1.25rem;
  }

  .credential-card__open path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .credential-card__pending-visual {
    display: grid;
    width: 100%;
    height: 100%;
    padding: var(--space-6);
    place-content: center;
    gap: 0.35rem;
    background:
      repeating-linear-gradient(-45deg, transparent 0 1rem, rgb(215 242 5 / 0.12) 1rem 2rem),
      var(--color-surface);
    text-align: center;
    text-transform: uppercase;
  }

  .credential-card__pending-visual strong {
    color: var(--color-lime);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
  }

  .credential-card__pending-visual span {
    color: var(--color-white);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .credential-card__body {
    display: grid;
    padding: var(--space-5) clamp(0.25rem, 0.8vw, 0.8rem) 0;
    align-items: start;
  }

  .credential-card__meta {
    display: flex;
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .credential-card__meta span {
    padding: 0.18rem 0.58rem;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .credential-card__meta span:last-child {
    background: var(--color-border);
    color: var(--color-black);
  }

  .credential-card__meta span.is-active {
    background: var(--color-lime);
  }

  h2 {
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.7rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  h2 button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  h2 button:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-lime);
    text-decoration-thickness: 0.25rem;
    text-underline-offset: 0.18em;
  }

  p {
    min-height: 3em;
    margin-bottom: var(--space-5);
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .credential-card__action {
    display: inline-flex;
    width: fit-content;
    min-height: 2.65rem;
    padding: 0.5rem 0.58rem 0.5rem 1.1rem;
    align-items: center;
    gap: 0.65rem;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--step--1);
    font-weight: 800;
    cursor: pointer;
    transition: background var(--motion-fast) ease, color var(--motion-fast) ease, transform var(--motion-fast) ease;
  }

  .credential-card__action svg {
    width: 1.6rem;
    padding: 0.24rem;
    border-radius: 50%;
    background: currentColor;
  }

  .credential-card__action path {
    fill: none;
    stroke: var(--color-black);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.7;
  }

  .credential-card__action:hover {
    background: var(--color-lime);
    color: var(--color-black);
    transform: translateY(-0.14rem);
  }

  @media (max-width: 42rem) {
    .credential-card__media {
      clip-path: polygon(0 0, calc(100% - 2rem) 0, 100% 2rem, 100% 100%, 2rem 100%, 0 calc(100% - 2rem));
    }

    p {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-card__media :global(> img),
    .credential-card__action {
      transition: none;
    }
  }
</style>
