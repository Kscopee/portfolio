---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PillButton from './PillButton.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectUrl = `${base}/projects/${data.slug}/`;
const typeLabels = {
  capstone: 'Capstone',
  iot: 'IoT',
  'third-year': 'Third-Year',
  'early-work': 'Early Work',
};
const imageEvidence = data.evidence.filter((item) => typeof item !== 'string');
const firstEvidence = data.slug === 'csoles-connect'
  ? imageEvidence.find((item) => item.caption.toLowerCase().includes('dashboard')) ?? imageEvidence[0]
  : imageEvidence[0];
const projectNumber = String(index + 1).padStart(2, '0');
---

<article class="project-card" data-project-card data-project-type={data.type}>
  <a class="project-card__media" href={projectUrl} aria-label={`View ${data.title}`}>
    {firstEvidence ? (
      <Image
        src={firstEvidence.image}
        alt={firstEvidence.caption}
        widths={[520, 840]}
        sizes="(max-width: 48rem) 92vw, (max-width: 78rem) 44vw, 38rem"
        loading={index < 2 ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="project-card__missing">
        <span>Content needed</span>
        <strong>Project evidence</strong>
      </div>
    )}
    <span class="project-card__number" aria-hidden="true">{projectNumber}</span>
  </a>

  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{typeLabels[data.type]}</span>
      <span>{data.year}</span>
      <span class:list={["project-card__status", { 'is-active': data.status === 'in-progress' }]}>
        {data.status === 'in-progress' ? 'In progress' : 'Completed'}
      </span>
    </div>
    <h2><a href={projectUrl}>{data.title}</a></h2>
    <p>{data.description}</p>
    <PillButton href={projectUrl} label="View project" tone="black" />
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .project-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 0.32rem solid var(--color-black);
    border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    background: var(--color-black);
    color: var(--color-white);
    clip-path: polygon(0 0, calc(100% - 2.9rem) 0, 100% 2.9rem, 100% 100%, 2.9rem 100%, 0 calc(100% - 2.9rem));
    text-decoration: none;
  }

  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) ease;
  }

  .project-card:hover .project-card__media :global(img),
  .project-card:focus-within .project-card__media :global(img) {
    transform: scale(1.035);
  }

  .project-card__missing {
    display: grid;
    height: 100%;
    padding: var(--space-6);
    place-content: center;
    gap: 0.45rem;
    background:
      repeating-linear-gradient(-45deg, transparent 0 0.8rem, rgb(215 242 5 / 0.16) 0.8rem 1.6rem),
      var(--color-surface);
    text-align: center;
    text-transform: uppercase;
  }

  .project-card__missing span {
    width: fit-content;
    margin-inline: auto;
    padding: 0.28rem 0.65rem;
    background: var(--color-lime);
    color: var(--color-black);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.09em;
  }

  .project-card__missing strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
  }

  .project-card__number {
    position: absolute;
    right: 0.85rem;
    bottom: 0.5rem;
    color: var(--color-lime);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    font-style: italic;
    letter-spacing: -0.05em;
    line-height: 0.78;
    text-shadow: 0.12rem 0.12rem 0 var(--color-black);
  }

  .project-card__body {
    display: grid;
    padding: var(--space-5) clamp(0.3rem, 1vw, 1rem) 0;
    align-items: start;
  }

  .project-card__meta {
    display: flex;
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-card__meta span {
    padding: 0.18rem 0.58rem;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: 0.69rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-card__meta .project-card__status {
    background: var(--color-border);
    color: var(--color-black);
  }

  .project-card__meta .project-card__status.is-active {
    background: var(--color-lime);
  }

  h2 {
    max-width: 27ch;
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: clamp(1.35rem, 1.05rem + 1.1vw, 2.15rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-lime);
    text-decoration-thickness: 0.28rem;
    text-underline-offset: 0.18em;
  }

  p {
    display: -webkit-box;
    margin-bottom: var(--space-5);
    overflow: hidden;
    color: var(--color-text);
    font-size: 0.95rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 42rem) {
    .project-card__media {
      clip-path: polygon(0 0, calc(100% - 2rem) 0, 100% 2rem, 100% 100%, 2rem 100%, 0 calc(100% - 2rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__media :global(img) {
      transition: none;
    }
  }
</style>
