---
interface Props {
  count?: number;
  active?: number;
  label?: string;
}

const { count = 4, active = 0, label = 'Carousel controls' } = Astro.props;
---

<div class="carousel-controls" aria-label={label}>
  <button class="carousel-controls__arrow" type="button" aria-label="Previous item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5 7.5 12l7 7" /></svg>
  </button>
  <div class="carousel-controls__dots" aria-label="Choose item">
    {Array.from({ length: count }, (_, index) => (
      <button
        type="button"
        aria-label={`Show item ${index + 1}`}
        aria-current={index === active ? 'true' : undefined}
      ></button>
    ))}
  </div>
  <button class="carousel-controls__arrow" type="button" aria-label="Next item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
  </button>
</div>

<style>
  .carousel-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .carousel-controls__arrow {
    display: grid;
    width: 3.15rem;
    height: 2.65rem;
    padding: 0.55rem;
    place-items: center;
    border: 2px solid var(--color-white);
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    cursor: pointer;
  }

  .carousel-controls__arrow:hover {
    background: var(--color-lime);
    color: var(--color-black);
  }

  .carousel-controls__arrow svg {
    width: 100%;
  }

  .carousel-controls__arrow path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .carousel-controls__dots {
    display: flex;
    gap: 0.6rem;
  }

  .carousel-controls__dots button {
    width: 0.78rem;
    height: 0.78rem;
    padding: 0;
    border: 2px solid var(--color-black);
    border-radius: 50%;
    background: var(--color-white);
    cursor: pointer;
    transition:
      width var(--motion-fast) var(--ease-snap),
      background-color var(--motion-fast) ease;
  }

  .carousel-controls__dots button[aria-current="true"] {
    width: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    box-shadow: inset 0 0 0 2px var(--color-white);
  }
</style>
