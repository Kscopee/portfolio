---
interface TabItem {
  label: string;
  value: string;
}

interface Props {
  label: string;
  items: TabItem[];
  active?: string;
}

const { label, items, active = items[0]?.value } = Astro.props;
---

<div class="pill-tabs" role="tablist" aria-label={label} data-pill-tabs>
  {items.map((item) => (
    <button
      class="pill-tabs__tab"
      type="button"
      role="tab"
      aria-selected={item.value === active ? 'true' : 'false'}
      tabindex={item.value === active ? 0 : -1}
      data-value={item.value}
    >
      {item.label}
    </button>
  ))}
</div>

<script>
  const setupPillTabs = () => document.querySelectorAll<HTMLElement>('[data-pill-tabs]').forEach((tabList) => {
    if (tabList.dataset.ready === 'true') return;
    tabList.dataset.ready = 'true';
    const tabs = [...tabList.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      tab.dispatchEvent(new CustomEvent('pill-tab-change', { bubbles: true, detail: { value: tab.dataset.value } }));
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        const nextTab = tabs[nextIndex];
        selectTab(nextTab);
        nextTab.focus();
      });
    });
  });

  document.addEventListener('astro:page-load', setupPillTabs);
  setupPillTabs();
</script>

<style>
  .pill-tabs {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    padding: 0.3rem;
    gap: 0.15rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    scrollbar-color: var(--color-lime) var(--color-black);
    scrollbar-width: thin;
    scroll-padding-inline: 0.3rem;
    scroll-snap-type: inline proximity;
  }

  .pill-tabs::-webkit-scrollbar {
    height: 0.32rem;
  }

  .pill-tabs::-webkit-scrollbar-track {
    background: var(--color-black);
  }

  .pill-tabs::-webkit-scrollbar-thumb {
    background: var(--color-lime);
  }

  .pill-tabs__tab {
    min-height: 2.5rem;
    padding: 0.55rem clamp(0.78rem, 1.4vw, 1.25rem);
    flex: 0 0 auto;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-white);
    font-size: var(--step--1);
    font-weight: 800;
    scroll-snap-align: start;
    white-space: nowrap;
    cursor: pointer;
  }

  .pill-tabs__tab[aria-selected="true"] {
    background: var(--color-lime);
    color: var(--color-black);
    clip-path: polygon(0.65rem 0, 100% 0, calc(100% - 0.65rem) 100%, 0 100%);
  }

  .pill-tabs__tab:hover:not([aria-selected="true"]) {
    color: var(--color-lime);
  }
</style>
