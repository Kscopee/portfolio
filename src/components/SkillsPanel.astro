---
import PillTabs from './PillTabs.astro';

interface Props {
  technical: string[];
  multimedia: Array<{
    name: string;
    plugin?: string;
    maker?: string;
  }>;
  soft: string[];
}

const { technical, multimedia, soft } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconNames: Record<string, string> = {
  HTML: 'html.svg',
  CSS: 'css.svg',
  JavaScript: 'javascript.svg',
  Astro: 'astro-light.svg',
  Bootstrap: 'bootstrap.svg',
  React: 'react.svg',
  Java: 'java.svg',
  C: 'c.svg',
  MySQL: 'mysql-light.svg',
  Git: 'git.svg',
  GitHub: 'github-light.svg',
  'VS Code': 'vscode.svg',
  'Android Studio': 'android-studio.svg',
  Communication: 'communication.webp',
  Networking: 'networking.webp',
  Organization: 'organization.webp',
  Creativity: 'creativity.webp',
  Curiosity: 'curiosity.webp',
  Dedication: 'dedication.webp',
  Adaptability: 'adaptability.webp',
};
const multimediaLogos: Record<string, { primary: string; secondary?: string; lightBacking?: boolean }> = {
  'Adobe After Effects': { primary: 'after-effects.webp' },
  'Adobe Premiere Pro': { primary: 'premiere-pro.svg' },
  'Cinema 4D': { primary: 'cinema-4d.webp', secondary: 'maxon.webp', lightBacking: true },
};
const iconUrl = (skill: string) => `${base}/assets/skills/${iconNames[skill]}`;
const multimediaIconUrl = (filename: string) => `${base}/assets/skills/${filename}`;
const tabs = [
  { label: 'Technical', value: 'technical', controls: 'technical-skills-panel' },
  { label: 'Soft', value: 'soft', controls: 'soft-skills-panel' },
];
---

<div class="skills-panel" data-skills-panel>
  <div class="skills-panel__head">
    <p>Tools I use and strengths I bring to a team.</p>
    <PillTabs id="skills-tabs" label="Choose skill type" items={tabs} active="technical" />
  </div>

  <div
    class="skills-grid"
    id="technical-skills-panel"
    role="tabpanel"
    aria-labelledby="skills-tabs-technical-tab"
    data-skill-group="technical"
  >
    <div class="skills-grid__main">
      {technical.map((skill, index) => (
        <article class="skill-card" style={`--skill-index: ${index}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <img src={iconUrl(skill)} alt="" loading="lazy" />
          <h3>{skill}</h3>
        </article>
      ))}
    </div>

    <section class="multimedia-skills" aria-labelledby="multimedia-skills-heading">
      <div class="multimedia-skills__heading">
        <p>Creative tools</p>
        <h3 id="multimedia-skills-heading">Multimedia</h3>
      </div>
      <div class="multimedia-skills__grid">
        {multimedia.map((skill, index) => {
          const logos = multimediaLogos[skill.name];
          return (
            <article class="skill-card skill-card--multimedia" style={`--skill-index: ${technical.length + index}`}>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class:list={["skill-card__brand", { 'skill-card__brand--light': logos.lightBacking }]}>
                <img src={multimediaIconUrl(logos.primary)} alt="" loading="lazy" />
              </div>
              <h4>{skill.name}</h4>
              {skill.plugin && (
                <div class="skill-card__detail skill-card__detail--plugin">
                  <span>Plugin</span>
                  <img src={multimediaIconUrl('boris-fx.webp')} alt="Boris FX" loading="lazy" />
                  <strong>Sapphire</strong>
                </div>
              )}
              {skill.maker && logos.secondary && (
                <div class="skill-card__detail skill-card__detail--maker">
                  <span>by</span>
                  <img src={multimediaIconUrl(logos.secondary)} alt={skill.maker} loading="lazy" />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </div>

  <div
    class="skills-grid skills-grid--soft"
    id="soft-skills-panel"
    role="tabpanel"
    aria-labelledby="skills-tabs-soft-tab"
    data-skill-group="soft"
    hidden
  >
    {soft.map((skill, index) => (
      <article class="skill-card" style={`--skill-index: ${index}`}>
        <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <img src={iconUrl(skill)} alt="" loading="lazy" />
        <h3>{skill}</h3>
      </article>
    ))}
  </div>
</div>

<script>
  let cleanUpSkillsPanels = () => {};

  const setupSkillsPanels = () => {
    cleanUpSkillsPanels();
    const cleanups: Array<() => void> = [];

    document.querySelectorAll<HTMLElement>('[data-skills-panel]').forEach((panel) => {
      const tabList = panel.querySelector<HTMLElement>('[data-pill-tabs]');
      const groups = [...panel.querySelectorAll<HTMLElement>('[data-skill-group]')];
      const changeHandler = (event: Event) => {
        const value = (event as CustomEvent<{ value: string }>).detail.value;
        groups.forEach((group) => { group.hidden = group.dataset.skillGroup !== value; });
      };
      tabList?.addEventListener('pill-tab-change', changeHandler);
      cleanups.push(() => tabList?.removeEventListener('pill-tab-change', changeHandler));
    });

    cleanUpSkillsPanels = () => cleanups.forEach((cleanup) => cleanup());
  };

  document.addEventListener('astro:page-load', setupSkillsPanels);
  setupSkillsPanels();
</script>

<style>
  .skills-panel {
    position: relative;
    z-index: 2;
    width: min(100%, 78rem);
    margin-inline: auto;
  }

  .skills-panel__head {
    display: flex;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .skills-panel__head > p {
    max-width: 28rem;
    margin: 0;
    color: var(--color-white);
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.25rem);
    font-weight: 800;
  }

  .skills-grid {
    display: block;
  }

  .skills-grid__main,
  .multimedia-skills__grid,
  .skills-grid--soft {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.8vw, 1.5rem);
  }

  .skills-grid[hidden] {
    display: none;
  }

  .skill-card {
    position: relative;
    display: grid;
    min-height: 11.5rem;
    padding: 1.4rem 1rem 1.2rem;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    overflow: hidden;
    border: 0.16rem solid var(--color-black);
    background: var(--color-surface);
    color: var(--color-white);
    box-shadow: 0.38rem 0.38rem 0 var(--color-black);
    clip-path: polygon(0 0, calc(100% - 1.5rem) 0, 100% 1.5rem, 100% 100%, 1.5rem 100%, 0 calc(100% - 1.5rem));
    transition: transform var(--motion-fast) var(--ease-snap), background var(--motion-fast) ease;
  }

  .skill-card:hover,
  .skill-card:focus-within {
    background: var(--color-surface-raised);
    transform: translateY(-0.35rem) rotate(-0.5deg);
  }

  .skill-card > span {
    position: absolute;
    top: 0.55rem;
    left: 0.7rem;
    color: var(--color-lime);
    font-size: 0.62rem;
    font-weight: 900;
  }

  .skill-card img {
    width: 3.8rem;
    height: 3.8rem;
    object-fit: contain;
  }

  .skill-card h3 {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
  }

  .multimedia-skills {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: var(--space-6);
    border-top: 0.15rem solid rgb(255 255 255 / 0.18);
  }

  .multimedia-skills__heading {
    display: flex;
    margin-bottom: var(--space-6);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .multimedia-skills__heading p {
    margin: 0;
    color: var(--color-lime);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .multimedia-skills__heading h3 {
    margin: 0;
    color: var(--color-white);
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    font-style: italic;
    text-transform: uppercase;
  }

  .multimedia-skills__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .skill-card--multimedia {
    min-height: 16rem;
    padding-top: 1.8rem;
    align-content: start;
  }

  .skill-card--multimedia h4 {
    margin: 0;
    color: var(--color-white);
    font-size: 1rem;
    line-height: 1.25;
    text-align: center;
  }

  .skill-card__brand {
    display: grid;
    width: 100%;
    height: 5.25rem;
    padding: 0.55rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .skill-card__brand--light {
    background: var(--color-paper);
  }

  .skill-card__brand img {
    width: 4.35rem;
    height: 4.35rem;
    object-fit: contain;
  }

  .skill-card__brand--light img {
    width: 100%;
    height: 100%;
  }

  .skill-card__detail {
    display: grid;
    width: 100%;
    min-height: 3.2rem;
    margin-top: auto;
    padding-top: 0.7rem;
    align-items: center;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .skill-card__detail > span {
    color: var(--color-muted-on-dark);
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skill-card__detail--plugin {
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.55rem;
  }

  .skill-card__detail--plugin img {
    width: 100%;
    height: 1.55rem;
    object-fit: contain;
  }

  .skill-card__detail--plugin strong {
    color: var(--color-white);
    font-size: 0.72rem;
  }

  .skill-card__detail--maker {
    grid-template-columns: auto minmax(0, 7rem);
    justify-content: center;
    gap: 0.55rem;
  }

  .skill-card__detail--maker img {
    width: 100%;
    height: 1.35rem;
    object-fit: contain;
  }

  @media (max-width: 60rem) {
    .skills-grid__main,
    .skills-grid--soft {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .skills-panel__head {
      align-items: stretch;
      flex-direction: column;
    }

    .skills-grid__main,
    .multimedia-skills__grid,
    .skills-grid--soft {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .multimedia-skills__grid .skill-card:last-child {
      grid-column: 1 / -1;
    }

    .multimedia-skills__heading {
      align-items: start;
      flex-direction: column;
    }

    .skill-card {
      min-height: 9.5rem;
      padding-inline: 0.7rem;
    }

    .skill-card img {
      width: 3.15rem;
      height: 3.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card {
      transition: none;
    }
  }
</style>
