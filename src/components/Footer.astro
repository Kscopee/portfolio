---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <a class="back-to-top" href="#top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 14.5 7-7 7 7" /></svg>
    <span>Top</span>
  </a>

  <div class="footer-contact">
    <div class="footer-intro">
      <p class="footer-kicker">Get in touch</p>
      <h2>LET'S MAKE<br /><em>IT REAL.</em></h2>
      <p>Send a message to Ashton. Replies go to the email you enter.</p>
      <a href="mailto:projectkfiles@gmail.com">projectkfiles@gmail.com</a>
    </div>

    <form class="contact-form" data-contact-form>
      <div class="form-field">
        <label for="contact-email">Your email</label>
        <input id="contact-email" name="from_email" type="email" autocomplete="email" maxlength="254" required />
      </div>
      <div class="form-field form-field--message">
        <label for="contact-message">Your message</label>
        <textarea id="contact-message" name="message" rows="4" minlength="10" maxlength="2000" required></textarea>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="form-actions">
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <button type="submit" data-submit-button>
          <span>Send message</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
        </button>
      </div>
    </form>
  </div>

  <div class="footer-bottom">
    <a class="footer-brand" href={withBase('/')}>
      <img src={withBase('/assets/brand/ashton-logo.png')} alt="" width="48" height="48" />
      <span class="footer-brand__name"><span>ASHTON</span><span>CASPE</span></span>
    </a>
    <div class="social-links" aria-label="Social links">
      <a href="https://github.com/Kscopee" target="_blank" rel="noopener noreferrer">
        <img src={withBase('/assets/brand/github.svg')} alt="" width="26" height="26" /><span>GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/ashton-james-caspe/" target="_blank" rel="noopener noreferrer">
        <img src={withBase('/assets/brand/linkedin.svg')} alt="" width="26" height="26" /><span>LinkedIn</span>
      </a>
    </div>
    <p>© {year} Ashton James D. Caspe</p>
  </div>
</footer>

<script>
  import emailjs from '@emailjs/browser';

  const setupContactForm = () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const buttonLabel = button?.querySelector('span');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !button || !status || !buttonLabel) return;

      const data = new FormData(form);
      if (String(data.get('website') || '').trim()) {
        form.reset();
        status.textContent = 'Message sent. Thank you!';
        status.dataset.state = 'success';
        return;
      }

      button.disabled = true;
      buttonLabel.textContent = 'Sending…';
      status.textContent = 'Sending your message…';
      status.dataset.state = 'pending';

      try {
        await emailjs.send('service_usctl47', 'template_e6fsk3h', {
          from_email: String(data.get('from_email') || ''),
          message: String(data.get('message') || ''),
          to_email: 'projectkfiles@gmail.com',
        }, { publicKey: 'G2P_85WXNra-Q-jj0' });
        form.reset();
        status.textContent = 'Message sent. Thank you!';
        status.dataset.state = 'success';
      } catch (error) {
        console.error('EmailJS error:', error);
        status.textContent = 'Message could not be sent. Please try again or email Ashton directly.';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        buttonLabel.textContent = 'Send message';
      }
    });
  };

  document.addEventListener('astro:page-load', setupContactForm);
  setupContactForm();
</script>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    padding-block: clamp(5.5rem, 9vw, 8rem) var(--space-5);
    padding-inline: var(--page-gutter) var(--page-safe-end);
    background: var(--color-black);
    color: var(--color-white);
    border-top: 1px solid var(--color-surface-raised);
  }
  .back-to-top {
    position: absolute;
    top: 0;
    left: clamp(var(--page-gutter), 12vw, 12rem);
    display: grid;
    width: 5rem;
    min-height: 5.2rem;
    place-items: center;
    align-content: center;
    gap: 0.1rem;
    border-radius: 0 0 1.5rem 1.5rem;
    background: var(--color-lime);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: var(--tracking-display-readable);
    line-height: var(--leading-display-readable);
    text-decoration: none;
    text-transform: uppercase;
  }
  .back-to-top svg { width: 1.5rem; }
  .back-to-top path { fill: none; stroke: currentColor; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 3; }
  .footer-contact {
    display: grid;
    width: min(100%, var(--content-max));
    margin-inline: auto;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
  }
  .footer-kicker { margin-bottom: var(--space-3); color: var(--color-lime); font-size: var(--step--1); font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .footer-intro h2 { margin-bottom: var(--space-5); color: var(--color-white); font-size: clamp(3rem, 5.6vw, 5.75rem); font-style: italic; }
  .footer-intro h2 em { color: var(--color-lime); font-style: inherit; }
  .footer-intro > p:not(.footer-kicker) { max-width: 31rem; color: #bdbdbd; }
  .footer-intro > a { color: var(--color-white); font-weight: 800; text-underline-offset: 0.25rem; }
  .contact-form { display: grid; grid-template-columns: 1fr; gap: var(--space-5); }
  .form-field { display: grid; gap: var(--space-2); }
  .form-field label { color: var(--color-paper); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .form-field input, .form-field textarea {
    width: 100%;
    border: 1px solid #555;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-white);
    padding: 0.9rem 1rem;
    resize: vertical;
  }
  .form-field input { min-height: 3.25rem; }
  .form-field textarea { min-height: 9.2rem; }
  .form-field input:focus, .form-field textarea:focus { border-color: var(--color-lime); outline: 0.18rem solid rgb(215 242 5 / 0.25); }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form-actions { display: flex; min-height: 3.3rem; align-items: center; justify-content: flex-end; gap: var(--space-4); }
  .form-status { margin: 0 auto 0 0; color: #cfcfcf; font-size: 0.78rem; line-height: 1.35; }
  .form-status[data-state='success'] { color: var(--color-lime); }
  .form-status[data-state='error'] { color: #ffb4b4; }
  .form-actions button {
    display: inline-flex;
    min-width: 10.75rem;
    min-height: 3.1rem;
    padding: 0.5rem 0.55rem 0.5rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    border: 2px solid var(--color-lime);
    border-radius: var(--radius-pill);
    background: var(--color-lime);
    color: var(--color-black);
    font-size: var(--step--1);
    font-weight: 800;
    cursor: pointer;
  }
  .form-actions button:disabled { cursor: wait; opacity: 0.65; }
  .form-actions button svg { width: 2rem; padding: 0.35rem; border-radius: 50%; background: var(--color-black); }
  .form-actions button path { fill: none; stroke: var(--color-lime); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.6; }
  .footer-bottom {
    display: grid;
    width: min(100%, var(--content-max));
    margin: var(--space-8) auto 0;
    padding-top: var(--space-5);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-5);
    border-top: 1px solid var(--color-surface-raised);
  }
  .footer-brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--color-white); font-family: var(--font-display); font-size: 1rem; letter-spacing: var(--tracking-display-readable); text-decoration: none; }
  .footer-brand img { width: 3rem; height: 3rem; object-fit: contain; }
  .footer-brand__name { display: grid; gap: 0.25rem; line-height: var(--leading-display-readable); }
  .social-links { display: flex; gap: var(--space-3); }
  .social-links a { display: inline-flex; min-height: 2.8rem; padding: 0.5rem 0.9rem; align-items: center; gap: 0.55rem; border: 1px solid var(--color-surface-raised); border-radius: var(--radius-pill); color: var(--color-white); font-size: var(--step--1); font-weight: 800; text-decoration: none; transition: border-color var(--motion-fast), color var(--motion-fast); }
  .social-links a:hover { border-color: var(--color-lime); color: var(--color-lime); }
  .social-links img { width: 1.35rem; height: 1.35rem; object-fit: contain; }
  .footer-bottom > p { justify-self: end; margin: 0; color: #a7a7a7; font-size: 0.7rem; }

  @media (max-width: 64rem) {
    .footer-contact { grid-template-columns: 1fr; }
    .footer-intro { max-width: 43rem; }
  }
  @media (max-width: 42rem) {
    .site-footer { padding-top: 6.5rem; }
    .back-to-top { left: var(--page-gutter); }
    .form-actions { align-items: stretch; flex-direction: column; }
    .form-actions button { width: 100%; }
    .footer-bottom { grid-template-columns: 1fr auto; }
    .footer-bottom > p { grid-column: 1 / -1; justify-self: start; }
    .social-links a { width: 2.8rem; padding: 0.5rem; justify-content: center; }
    .social-links span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>
