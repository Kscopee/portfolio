---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ViewerItem {
  kind: 'Certification' | 'Course completion';
  title: string;
  provider: string;
  dateLabel: string;
  status: 'completed' | 'in-progress';
  certificateImage?: ImageMetadata;
  badgeImage?: ImageMetadata;
  verifyUrl?: string;
  pdfUrl?: string;
  modules?: string[];
}

interface Props {
  items: ViewerItem[];
}

const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<dialog class="credential-viewer" data-credential-viewer aria-labelledby="credential-viewer-title">
  <div class="credential-viewer__shell">
    <header class="credential-viewer__header">
      <div>
        <p data-viewer-kind>Credential</p>
        <h2 id="credential-viewer-title" data-viewer-title>Certificate viewer</h2>
      </div>
      <button class="credential-viewer__close" type="button" data-viewer-close aria-label="Close certificate viewer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </header>

    <div class="credential-viewer__panels">
      {items.map((item, index) => (
        <article class="credential-viewer__panel" data-viewer-panel={index} hidden={index !== 0}>
          <div class:list={["credential-viewer__media", { 'credential-viewer__media--pending': !item.certificateImage }]}>
            {item.certificateImage ? (
              <Image
                src={item.certificateImage}
                alt={`Certificate for ${item.title}`}
                widths={[800, 1200, 1800]}
                sizes="(max-width: 54rem) 90vw, 65vw"
                loading="lazy"
              />
            ) : (
              <div class="credential-viewer__pending">
                <strong>In progress</strong>
                <span>No certificate has been issued yet.</span>
              </div>
            )}
          </div>

          <aside class="credential-viewer__details">
            {item.badgeImage && (
              <Image
                class="credential-viewer__badge"
                src={item.badgeImage}
                alt={`${item.title} badge`}
                widths={[120, 200]}
                sizes="6rem"
                loading="lazy"
              />
            )}
            <dl>
              <div>
                <dt>Issuer / provider</dt>
                <dd>{item.provider}</dd>
              </div>
              <div>
                <dt>{item.status === 'in-progress' ? 'Status' : 'Earned / completed'}</dt>
                <dd>{item.status === 'in-progress' ? 'In progress' : item.dateLabel}</dd>
              </div>
            </dl>

            {item.modules && item.modules.length > 0 && (
              <section class="credential-viewer__modules" aria-labelledby={`viewer-modules-${index}`}>
                <h3 id={`viewer-modules-${index}`}>Modules</h3>
                <ul>
                  {item.modules.map((module) => <li>{module}</li>)}
                </ul>
              </section>
            )}

            <div class="credential-viewer__links">
              {item.verifyUrl && (
                <a href={item.verifyUrl} target="_blank" rel="noreferrer">
                  <span>Verify credential</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </a>
              )}
              {item.pdfUrl && (
                <a href={`${base}/${item.pdfUrl}`} target="_blank" rel="noreferrer">
                  <span>Open PDF</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
                </a>
              )}
              {!item.verifyUrl && !item.pdfUrl && (
                <p class="credential-viewer__no-link">
                  {item.status === 'in-progress' ? 'No verification link is available for this in-progress course.' : 'No public verification link was provided.'}
                </p>
              )}
            </div>
          </aside>
        </article>
      ))}
    </div>

    <footer class="credential-viewer__nav" aria-label="Certificate viewer controls">
      <button type="button" data-viewer-previous>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
        <span>Previous</span>
      </button>
      <p><strong data-viewer-current>01</strong> / <span>{String(items.length).padStart(2, '0')}</span></p>
      <button type="button" data-viewer-next>
        <span>Next</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
      </button>
    </footer>
  </div>
</dialog>

<script>
  let cleanUpCredentialViewer = () => {};

  const setupCredentialViewer = () => {
    cleanUpCredentialViewer();

    const dialog = document.querySelector<HTMLDialogElement>('[data-credential-viewer]');
    if (!dialog) return;

    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-viewer-open]')];
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-viewer-panel]')];
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-previous]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]');
    const title = dialog.querySelector<HTMLElement>('[data-viewer-title]');
    const kind = dialog.querySelector<HTMLElement>('[data-viewer-kind]');
    const current = dialog.querySelector<HTMLElement>('[data-viewer-current]');
    let activeIndex = 0;
    let returnFocus: HTMLElement | null = null;

    const showPanel = (index: number) => {
      activeIndex = (index + panels.length) % panels.length;
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== activeIndex; });
      const activeTrigger = triggers.find((trigger) => Number(trigger.dataset.viewerOpen) === activeIndex);
      const activePanel = panels[activeIndex];
      if (title) title.textContent = activeTrigger?.dataset.viewerTitle ?? 'Certificate viewer';
      if (kind) kind.textContent = activePanel?.querySelector('dt')?.textContent === 'Issuer / provider'
        ? activeTrigger?.closest('[data-credential-kind]')?.getAttribute('data-credential-kind') ?? 'Credential'
        : 'Credential';
      if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
      activePanel?.scrollTo({ top: 0, behavior: 'auto' });
      if (document.activeElement?.closest('[data-viewer-panel][hidden]')) closeButton?.focus();
    };

    const closeViewer = () => {
      if (!dialog.open) return;
      dialog.close();
      document.body.classList.remove('credential-viewer-open');
      returnFocus?.focus();
      returnFocus = null;
    };

    const openViewer = (trigger: HTMLButtonElement) => {
      returnFocus = trigger;
      showPanel(Number(trigger.dataset.viewerOpen ?? 0));
      dialog.showModal();
      document.body.classList.add('credential-viewer-open');
      closeButton?.focus();
    };

    const clickHandlers = triggers.map((trigger) => {
      const handler = () => openViewer(trigger);
      trigger.addEventListener('click', handler);
      return () => trigger.removeEventListener('click', handler);
    });

    const closeHandler = () => closeViewer();
    const previousHandler = () => showPanel(activeIndex - 1);
    const nextHandler = () => showPanel(activeIndex + 1);
    const cancelHandler = (event: Event) => {
      event.preventDefault();
      closeViewer();
    };
    const backdropHandler = (event: MouseEvent) => {
      if (event.target === dialog) closeViewer();
    };
    const keyHandler = (event: KeyboardEvent) => {
      if (!dialog.open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeViewer();
        return;
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPanel(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPanel(activeIndex + 1);
      }
      if (event.key !== 'Tab') return;

      const focusable = [...dialog.querySelectorAll<HTMLElement>(
        'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
      )].filter((element) => !element.closest('[hidden]'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    closeButton?.addEventListener('click', closeHandler);
    previousButton?.addEventListener('click', previousHandler);
    nextButton?.addEventListener('click', nextHandler);
    dialog.addEventListener('cancel', cancelHandler);
    dialog.addEventListener('click', backdropHandler);
    dialog.addEventListener('keydown', keyHandler);

    cleanUpCredentialViewer = () => {
      clickHandlers.forEach((cleanup) => cleanup());
      closeButton?.removeEventListener('click', closeHandler);
      previousButton?.removeEventListener('click', previousHandler);
      nextButton?.removeEventListener('click', nextHandler);
      dialog.removeEventListener('cancel', cancelHandler);
      dialog.removeEventListener('click', backdropHandler);
      dialog.removeEventListener('keydown', keyHandler);
      document.body.classList.remove('credential-viewer-open');
      if (dialog.open) dialog.close();
    };
  };

  document.addEventListener('astro:page-load', setupCredentialViewer);
  setupCredentialViewer();
</script>

<style>
  .credential-viewer {
    width: min(92rem, calc(100vw - 3rem));
    max-width: none;
    max-height: calc(100svh - 3rem);
    padding: 0;
    overflow: visible;
    border: 0.32rem solid var(--color-black);
    border-radius: var(--radius-md);
    background: var(--color-paper);
    color: var(--color-text);
    box-shadow: 0.75rem 0.75rem 0 var(--color-lime);
  }

  .credential-viewer::backdrop {
    background: rgb(0 0 0 / 0.78);
    backdrop-filter: blur(0.45rem);
  }

  .credential-viewer__shell {
    display: grid;
    max-height: calc(100svh - 3.6rem);
    overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .credential-viewer__header {
    display: flex;
    min-height: 6rem;
    padding: var(--space-4) var(--space-5);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    background: var(--color-black);
    color: var(--color-white);
  }

  .credential-viewer__header p {
    margin-bottom: 0.15rem;
    color: var(--color-lime);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .credential-viewer__header h2 {
    max-width: 43ch;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 0.9rem + 1vw, 2rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .credential-viewer__close {
    display: grid;
    width: 3rem;
    flex: 0 0 auto;
    aspect-ratio: 1;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--color-lime);
    color: var(--color-black);
    cursor: pointer;
  }

  .credential-viewer__close svg {
    width: 1.5rem;
  }

  .credential-viewer__close path,
  .credential-viewer__nav path,
  .credential-viewer__links path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .credential-viewer__panels {
    min-height: 0;
  }

  .credential-viewer__panel {
    height: 100%;
    min-height: 0;
    overflow: auto;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.65fr);
  }

  .credential-viewer__panel:not([hidden]) {
    display: grid;
  }

  .credential-viewer__media {
    display: grid;
    min-height: 0;
    padding: clamp(1rem, 2.8vw, 2.5rem);
    place-items: center;
    overflow: hidden;
    background:
      repeating-linear-gradient(112deg, transparent 0 10px, rgb(255 255 255 / 0.04) 10px 12px),
      var(--color-surface);
  }

  .credential-viewer__media :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100svh - 17rem);
    object-fit: contain;
    filter: drop-shadow(0.55rem 0.55rem 0 rgb(0 0 0 / 0.46));
  }

  .credential-viewer__media--pending {
    background:
      repeating-linear-gradient(-45deg, transparent 0 1.2rem, rgb(215 242 5 / 0.1) 1.2rem 2.4rem),
      var(--color-surface);
  }

  .credential-viewer__pending {
    display: grid;
    width: min(32rem, 90%);
    min-height: 18rem;
    padding: var(--space-7);
    place-content: center;
    gap: var(--space-3);
    border: 0.25rem solid var(--color-lime);
    text-align: center;
    clip-path: polygon(0 0, calc(100% - 3rem) 0, 100% 3rem, 100% 100%, 3rem 100%, 0 calc(100% - 3rem));
  }

  .credential-viewer__pending strong {
    color: var(--color-lime);
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4vw, 4rem);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
    text-transform: uppercase;
  }

  .credential-viewer__pending span {
    color: var(--color-white);
    font-weight: 800;
  }

  .credential-viewer__details {
    padding: clamp(1.5rem, 3vw, 3rem);
    overflow: auto;
    border-left: 0.55rem solid var(--color-lime);
    background: var(--color-white);
  }

  .credential-viewer__badge {
    width: clamp(4.6rem, 8vw, 7rem);
    max-height: 7rem;
    margin-bottom: var(--space-5);
    object-fit: contain;
  }

  dl {
    display: grid;
    margin: 0;
    gap: var(--space-5);
  }

  dt {
    margin-bottom: 0.25rem;
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-black);
    font-weight: 800;
    line-height: 1.35;
  }

  .credential-viewer__modules {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px dashed var(--color-black);
  }

  .credential-viewer__modules h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .credential-viewer__modules ul {
    display: grid;
    padding: 0;
    margin: 0;
    gap: 0.6rem;
    list-style: none;
  }

  .credential-viewer__modules li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .credential-viewer__modules li::before {
    position: absolute;
    top: 0.52em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-lime);
    content: '';
    transform: rotate(45deg);
  }

  .credential-viewer__links {
    display: grid;
    margin-top: var(--space-7);
    gap: var(--space-3);
  }

  .credential-viewer__links a {
    display: flex;
    min-height: 2.9rem;
    padding: 0.6rem 0.75rem 0.6rem 1.1rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
  }

  .credential-viewer__links a:hover {
    background: var(--color-lime);
    color: var(--color-black);
  }

  .credential-viewer__links svg {
    width: 1.3rem;
    flex: 0 0 auto;
  }

  .credential-viewer__no-link {
    margin: 0;
    padding: var(--space-4);
    border-left: 0.4rem solid var(--color-lime);
    background: var(--color-paper);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .credential-viewer__nav {
    display: grid;
    min-height: 3.8rem;
    padding: 0.45rem var(--space-4);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    border-top: 0.2rem solid var(--color-black);
    background: var(--color-lime);
    color: var(--color-black);
  }

  .credential-viewer__nav button {
    display: inline-flex;
    width: fit-content;
    padding: 0.35rem;
    align-items: center;
    gap: 0.45rem;
    border: 0;
    background: transparent;
    font-size: 0.75rem;
    font-weight: 900;
    cursor: pointer;
  }

  .credential-viewer__nav button:last-child {
    justify-self: end;
  }

  .credential-viewer__nav svg {
    width: 1.5rem;
  }

  .credential-viewer__nav p {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  @media (max-width: 54rem) {
    .credential-viewer {
      width: calc(100vw - 1.5rem);
      max-height: calc(100svh - 1.5rem);
      box-shadow: 0.4rem 0.4rem 0 var(--color-lime);
    }

    .credential-viewer__shell {
      max-height: calc(100svh - 2.1rem);
    }

    .credential-viewer__panel {
      grid-template-columns: 1fr;
    }

    .credential-viewer__media {
      min-height: 18rem;
    }

    .credential-viewer__media :global(img) {
      max-height: 58svh;
    }

    .credential-viewer__details {
      overflow: visible;
      border-top: 0.55rem solid var(--color-lime);
      border-left: 0;
    }
  }

  @media (max-width: 32rem) {
    .credential-viewer__header {
      min-height: 5rem;
      padding: var(--space-3) var(--space-4);
    }

    .credential-viewer__media {
      min-height: 14rem;
      padding: var(--space-3);
    }

    .credential-viewer__details {
      padding: var(--space-5);
    }

    .credential-viewer__nav button span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-viewer::backdrop {
      backdrop-filter: none;
    }
  }
</style>

<style is:global>
  body.credential-viewer-open {
    overflow: hidden;
  }
</style>
