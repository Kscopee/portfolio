---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CutFrame from './CutFrame.astro';

interface ViewerItem {
  kind: 'Certification' | 'Course completion';
  title: string;
  provider: string;
  dateLabel: string;
  status: 'completed' | 'in-progress';
  certificateImage?: ImageMetadata;
  badgeImage?: ImageMetadata;
  verifyUrl?: string;
  pdfUrl?: string;
  modules?: string[];
}

interface Props {
  items: ViewerItem[];
}

const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<dialog class="credential-viewer" data-credential-viewer aria-labelledby="credential-viewer-title-0">
  <div class="credential-viewer__shell">
    <button class="credential-viewer__close" type="button" data-viewer-close aria-label="Close certificate viewer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>

    <div class="credential-viewer__panels">
      {items.map((item, index) => (
        <article class="credential-viewer__panel" data-viewer-panel={index} hidden={index !== 0}>
          <div class="credential-viewer__media">
            <CutFrame variant="double" accent="black">
              {item.certificateImage ? (
                <Image
                  src={item.certificateImage}
                  alt={`Certificate for ${item.title}`}
                  widths={[900, 1400, 2000]}
                  sizes="(max-width: 54rem) calc(100vw - 4rem), 70vw"
                  loading="lazy"
                />
              ) : (
                <div class="credential-viewer__pending">
                  <strong>In progress</strong>
                  <span>No certificate has been issued yet.</span>
                </div>
              )}
            </CutFrame>
          </div>

          <aside class="credential-viewer__details">
            <div class="credential-viewer__heading">
              {item.badgeImage && (
                <Image
                  class="credential-viewer__badge"
                  src={item.badgeImage}
                  alt={`${item.title} badge`}
                  widths={[120, 200]}
                  sizes="5rem"
                  loading="lazy"
                />
              )}
              <div>
                <p>{item.kind}</p>
                <h2 id={`credential-viewer-title-${index}`} data-panel-title>{item.title}</h2>
              </div>
            </div>

            <dl>
              <div>
                <dt>Issuer / provider</dt>
                <dd>{item.provider}</dd>
              </div>
              <div>
                <dt>{item.status === 'in-progress' ? 'Status' : 'Earned / completed'}</dt>
                <dd>{item.status === 'in-progress' ? 'In progress' : item.dateLabel}</dd>
              </div>
            </dl>

            {item.modules && item.modules.length > 0 && (
              <section class="credential-viewer__modules" aria-labelledby={`viewer-modules-${index}`}>
                <h3 id={`viewer-modules-${index}`}>Modules</h3>
                <ul>
                  {item.modules.map((module) => <li>{module}</li>)}
                </ul>
              </section>
            )}

            <div class="credential-viewer__links">
              {item.verifyUrl && (
                <a href={item.verifyUrl} target="_blank" rel="noreferrer">
                  <span>Verify credential</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </a>
              )}
              {item.pdfUrl && (
                <a href={`${base}/${item.pdfUrl}`} target="_blank" rel="noreferrer">
                  <span>Open PDF</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
                </a>
              )}
              {!item.verifyUrl && !item.pdfUrl && (
                <p class="credential-viewer__no-link">
                  {item.status === 'in-progress' ? 'No verification link is available for this in-progress course.' : 'No public verification link was provided.'}
                </p>
              )}
            </div>
          </aside>
        </article>
      ))}
    </div>

    <button class="credential-viewer__arrow credential-viewer__arrow--previous" type="button" data-viewer-previous>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
      <span class="visually-hidden">Previous credential</span>
    </button>
    <button class="credential-viewer__arrow credential-viewer__arrow--next" type="button" data-viewer-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
      <span class="visually-hidden">Next credential</span>
    </button>
    <p class="credential-viewer__counter" aria-live="polite">
      <strong data-viewer-current>01</strong> / <span>{String(items.length).padStart(2, '0')}</span>
    </p>
  </div>
</dialog>

<script>
  let cleanUpCredentialViewer = () => {};

  const setupCredentialViewer = () => {
    cleanUpCredentialViewer();

    const dialog = document.querySelector<HTMLDialogElement>('[data-credential-viewer]');
    if (!dialog) return;

    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-viewer-open]')];
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-viewer-panel]')];
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-previous]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-viewer-next]');
    const current = dialog.querySelector<HTMLElement>('[data-viewer-current]');
    let activeIndex = 0;
    let returnFocus: HTMLElement | null = null;

    const showPanel = (index: number) => {
      activeIndex = (index + panels.length) % panels.length;
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== activeIndex; });
      const activePanel = panels[activeIndex];
      const activeTitle = activePanel?.querySelector<HTMLElement>('[data-panel-title]');
      if (activeTitle?.id) dialog.setAttribute('aria-labelledby', activeTitle.id);
      if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
      activePanel?.scrollTo({ top: 0, behavior: 'auto' });
      if (document.activeElement?.closest('[data-viewer-panel][hidden]')) closeButton?.focus();
    };

    const closeViewer = () => {
      if (!dialog.open) return;
      dialog.close();
      document.body.classList.remove('credential-viewer-open');
      returnFocus?.focus();
      returnFocus = null;
    };

    const openViewer = (trigger: HTMLButtonElement) => {
      returnFocus = trigger;
      showPanel(Number(trigger.dataset.viewerOpen ?? 0));
      dialog.showModal();
      document.body.classList.add('credential-viewer-open');
      closeButton?.focus();
    };

    const clickHandlers = triggers.map((trigger) => {
      const handler = () => openViewer(trigger);
      trigger.addEventListener('click', handler);
      return () => trigger.removeEventListener('click', handler);
    });

    const closeHandler = () => closeViewer();
    const previousHandler = () => showPanel(activeIndex - 1);
    const nextHandler = () => showPanel(activeIndex + 1);
    const cancelHandler = (event: Event) => {
      event.preventDefault();
      closeViewer();
    };
    const backdropHandler = (event: MouseEvent) => {
      if (event.target === dialog) closeViewer();
    };
    const keyHandler = (event: KeyboardEvent) => {
      if (!dialog.open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeViewer();
        return;
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPanel(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPanel(activeIndex + 1);
      }
      if (event.key !== 'Tab') return;

      const focusable = [...dialog.querySelectorAll<HTMLElement>(
        'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
      )].filter((element) => !element.closest('[hidden]'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    closeButton?.addEventListener('click', closeHandler);
    previousButton?.addEventListener('click', previousHandler);
    nextButton?.addEventListener('click', nextHandler);
    dialog.addEventListener('cancel', cancelHandler);
    dialog.addEventListener('click', backdropHandler);
    dialog.addEventListener('keydown', keyHandler);

    cleanUpCredentialViewer = () => {
      clickHandlers.forEach((cleanup) => cleanup());
      closeButton?.removeEventListener('click', closeHandler);
      previousButton?.removeEventListener('click', previousHandler);
      nextButton?.removeEventListener('click', nextHandler);
      dialog.removeEventListener('cancel', cancelHandler);
      dialog.removeEventListener('click', backdropHandler);
      dialog.removeEventListener('keydown', keyHandler);
      document.body.classList.remove('credential-viewer-open');
      if (dialog.open) dialog.close();
    };
  };

  document.addEventListener('astro:page-load', setupCredentialViewer);
  setupCredentialViewer();
</script>

<style>
  .credential-viewer {
    width: min(96rem, calc(100vw - 2.5rem));
    max-width: none;
    max-height: calc(100svh - 2.5rem);
    padding: 0;
    overflow: visible;
    border: 0.18rem solid var(--color-black);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-white);
    box-shadow: none;
  }

  .credential-viewer::backdrop {
    background: rgb(0 0 0 / 0.58);
    backdrop-filter: blur(0.9rem) saturate(0.7);
  }

  .credential-viewer__shell {
    position: relative;
    max-height: calc(100svh - 2.9rem);
    min-height: min(50rem, calc(100svh - 2.9rem));
    overflow: hidden;
    border-radius: calc(var(--radius-md) - 0.18rem);
    background:
      repeating-linear-gradient(108deg, transparent 0 10px, rgb(255 255 255 / 0.025) 10px 12px),
      var(--color-surface);
  }

  .credential-viewer__panels {
    height: 100%;
    min-height: inherit;
  }

  .credential-viewer__panel {
    height: min(50rem, calc(100svh - 2.9rem));
    min-height: 0;
    grid-template-columns: minmax(0, 3.15fr) minmax(19rem, 0.95fr);
    overflow: hidden;
  }

  .credential-viewer__panel:not([hidden]) {
    display: grid;
  }

  .credential-viewer__media {
    display: grid;
    min-width: 0;
    min-height: 0;
    padding: clamp(4rem, 5vw, 5.5rem) clamp(3rem, 5vw, 5.5rem) clamp(3rem, 4vw, 4.5rem);
    place-items: center;
    background: rgb(0 0 0 / 0.18);
  }

  .credential-viewer__media :global(.cut-frame) {
    width: auto;
    max-width: 100%;
    height: min(76svh, 47rem);
    aspect-ratio: 22 / 17;
    filter: none;
  }

  .credential-viewer__media :global(.cut-frame__media) {
    height: 100%;
    min-height: 0;
    border-width: 0.25rem;
  }

  .credential-viewer__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-white);
  }

  .credential-viewer__pending {
    display: grid;
    width: 100%;
    height: 100%;
    padding: var(--space-7);
    place-content: center;
    gap: var(--space-3);
    background:
      repeating-linear-gradient(-45deg, transparent 0 1.2rem, rgb(215 242 5 / 0.1) 1.2rem 2.4rem),
      var(--color-ink);
    text-align: center;
  }

  .credential-viewer__pending strong {
    color: var(--color-lime);
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4vw, 4rem);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
    text-transform: uppercase;
  }

  .credential-viewer__pending span {
    color: var(--color-white);
    font-weight: 800;
  }

  .credential-viewer__details {
    min-width: 0;
    padding: clamp(4.8rem, 6vw, 6.5rem) clamp(1.7rem, 3vw, 3rem) 4rem;
    overflow: auto;
    border-left: 1px solid rgb(255 255 255 / 0.13);
    background: transparent;
    color: var(--color-white);
  }

  .credential-viewer__heading {
    display: flex;
    margin-bottom: var(--space-7);
    align-items: start;
    gap: var(--space-4);
  }

  .credential-viewer__heading p {
    margin-bottom: 0.35rem;
    color: var(--color-lime);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .credential-viewer__heading h2 {
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.85rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .credential-viewer__badge {
    width: clamp(3.7rem, 6vw, 5.2rem);
    max-height: 5.2rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  dl {
    display: grid;
    margin: 0;
    gap: var(--space-5);
  }

  dt {
    margin-bottom: 0.25rem;
    color: rgb(255 255 255 / 0.62);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-white);
    font-weight: 800;
    line-height: 1.35;
  }

  .credential-viewer__modules {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 2px dashed rgb(255 255 255 / 0.3);
  }

  .credential-viewer__modules h3 {
    margin-bottom: var(--space-3);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .credential-viewer__modules ul {
    display: grid;
    padding: 0;
    margin: 0;
    gap: 0.6rem;
    list-style: none;
  }

  .credential-viewer__modules li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--color-paper);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .credential-viewer__modules li::before {
    position: absolute;
    top: 0.52em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-lime);
    content: '';
    transform: rotate(45deg);
  }

  .credential-viewer__links {
    display: grid;
    margin-top: var(--space-7);
    gap: var(--space-3);
  }

  .credential-viewer__links a {
    display: flex;
    min-height: 2.9rem;
    padding: 0.6rem 0.75rem 0.6rem 1.1rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border: 2px solid var(--color-white);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--color-black);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
  }

  .credential-viewer__links a:hover {
    border-color: var(--color-lime);
    background: var(--color-lime);
  }

  .credential-viewer__links svg {
    width: 1.3rem;
    flex: 0 0 auto;
  }

  .credential-viewer__links path,
  .credential-viewer__close path,
  .credential-viewer__arrow path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .credential-viewer__no-link {
    margin: 0;
    padding: var(--space-4);
    border-left: 0.3rem solid var(--color-lime);
    background: rgb(255 255 255 / 0.07);
    color: var(--color-paper);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .credential-viewer__close,
  .credential-viewer__arrow {
    position: absolute;
    z-index: 5;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 0.16rem solid var(--color-lime);
    border-radius: 50%;
    background: var(--color-black);
    color: var(--color-white);
    cursor: pointer;
    transition: background var(--motion-fast) ease, color var(--motion-fast) ease, transform var(--motion-fast) ease;
  }

  .credential-viewer__close:hover,
  .credential-viewer__arrow:hover {
    background: var(--color-lime);
    color: var(--color-black);
  }

  .credential-viewer__close {
    top: 1rem;
    right: 1rem;
    width: 3.2rem;
  }

  .credential-viewer__close svg {
    width: 1.45rem;
  }

  .credential-viewer__arrow {
    top: 50%;
    width: 2.8rem;
    transform: translateY(-50%);
  }

  .credential-viewer__arrow:hover {
    transform: translateY(-50%) scale(1.06);
  }

  .credential-viewer__arrow--previous {
    left: 0.85rem;
  }

  .credential-viewer__arrow--next {
    right: 0.85rem;
  }

  .credential-viewer__arrow svg {
    width: 1.35rem;
  }

  .credential-viewer__counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    z-index: 5;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-black);
    color: var(--color-white);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    transform: translateX(-50%);
  }

  .credential-viewer__counter strong {
    color: var(--color-lime);
  }

  @media (max-width: 70rem) {
    .credential-viewer__panel {
      grid-template-columns: minmax(0, 2.25fr) minmax(18rem, 1fr);
    }

    .credential-viewer__media {
      padding-inline: 3rem;
    }
  }

  @media (max-width: 54rem) {
    .credential-viewer {
      width: calc(100vw - 1.25rem);
      max-height: calc(100svh - 1.25rem);
    }

    .credential-viewer__shell,
    .credential-viewer__panels {
      max-height: calc(100svh - 1.6rem);
      min-height: 0;
    }

    .credential-viewer__panel {
      height: auto;
      max-height: calc(100svh - 1.6rem);
      overflow-y: auto;
      grid-template-columns: 1fr;
    }

    .credential-viewer__media {
      min-height: 0;
      padding: 4.5rem 1rem 1rem;
    }

    .credential-viewer__media :global(.cut-frame) {
      width: 100%;
      height: auto;
      aspect-ratio: 22 / 17;
    }

    .credential-viewer__details {
      padding: var(--space-6) var(--space-5) 5rem;
      overflow: visible;
      border-top: 1px solid rgb(255 255 255 / 0.13);
      border-left: 0;
    }

    .credential-viewer__arrow {
      top: 12rem;
      width: 2.55rem;
    }

    .credential-viewer__arrow--previous {
      left: 0.4rem;
    }

    .credential-viewer__arrow--next {
      right: 0.4rem;
    }

    .credential-viewer__counter {
      bottom: 0.65rem;
    }
  }

  @media (max-width: 32rem) {
    .credential-viewer__close {
      top: 0.65rem;
      right: 0.65rem;
      width: 2.9rem;
    }

    .credential-viewer__heading h2 {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-viewer::backdrop {
      backdrop-filter: none;
    }

    .credential-viewer__close,
    .credential-viewer__arrow {
      transition: none;
    }
  }
</style>

<style is:global>
  body.credential-viewer-open {
    overflow: hidden;
  }
</style>
