---
interface Props {
  variant?: 'light' | 'dark' | 'split';
}

const { variant = 'light' } = Astro.props;
---

<div class:list={["diagonal-bands", `diagonal-bands--${variant}`]} aria-hidden="true">
  <span class="diagonal-bands__stripe"></span>
  <span class="diagonal-bands__accent"></span>
</div>

<style>
  .diagonal-bands {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .diagonal-bands::before,
  .diagonal-bands__stripe,
  .diagonal-bands__accent {
    position: absolute;
    content: "";
  }

  .diagonal-bands::before {
    inset: -12% 38% -12% -18%;
    background: var(--color-black);
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .diagonal-bands__stripe {
    inset: -8% 45% -8% -12%;
    background: repeating-linear-gradient(
      105deg,
      rgb(255 255 255 / 4%) 0,
      rgb(255 255 255 / 4%) 8px,
      transparent 8px,
      transparent 12px
    );
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .diagonal-bands__accent {
    right: -14%;
    bottom: -9%;
    width: 68%;
    height: 28%;
    background: var(--color-lime);
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .diagonal-bands--dark {
    background: var(--color-surface);
  }

  .diagonal-bands--dark::before {
    background: var(--color-black);
  }

  .diagonal-bands--split::before {
    inset: -12% 44% -12% -16%;
  }

  .diagonal-bands--split .diagonal-bands__stripe {
    inset-inline-end: 49%;
  }

  .diagonal-bands--split .diagonal-bands__accent {
    top: -14%;
    right: -10%;
    bottom: auto;
    width: 42%;
    height: 52%;
  }

  @media (max-width: 48rem) {
    .diagonal-bands::before {
      inset-inline-end: 52%;
    }

    .diagonal-bands__stripe {
      inset-inline-end: 58%;
    }

    .diagonal-bands__accent {
      width: 76%;
      height: 18%;
    }

    .diagonal-bands--split::before {
      inset-inline-end: 4%;
    }

    .diagonal-bands--split .diagonal-bands__stripe {
      inset-inline-end: 10%;
    }

    .diagonal-bands--split .diagonal-bands__accent {
      width: 34%;
      height: 35%;
    }
  }
</style>
