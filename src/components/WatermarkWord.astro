---
interface Props {
  word: string;
  tone?: 'light' | 'dark';
}

const { word, tone = 'light' } = Astro.props;
---

<span class:list={["watermark", `watermark--${tone}`]} aria-hidden="true">{word}</span>

<style>
  .watermark {
    position: absolute;
    z-index: 0;
    color: rgb(0 0 0 / 6%);
    font-family: var(--font-display);
    font-size: clamp(5rem, 17vw, 17rem);
    font-style: italic;
    line-height: 0.75;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .watermark--dark {
    color: rgb(255 255 255 / 8%);
  }
</style>
