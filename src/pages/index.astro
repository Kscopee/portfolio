---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import aboutPortrait from '../assets/content/about/ashton-about-portrait.png';
import CutFrame from '../components/CutFrame.astro';
import FilmStripDivider from '../components/FilmStripDivider.astro';
import PillButton from '../components/PillButton.astro';
import SectionRail from '../components/SectionRail.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WatermarkWord from '../components/WatermarkWord.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path = '') => `${base}/${path.replace(/^\//, '')}`;

const aboutEntry = (await getCollection('about'))[0];
if (!aboutEntry) throw new Error('The About content entry is missing.');

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
});
if (!projects.length) throw new Error('A project is required for the homepage.');

const projectTypeLabels = {
  capstone: 'Capstone',
  iot: 'IoT',
  'third-year': 'Third-Year',
  'early-work': 'Early Work',
};

const previewDescription = (description: string) => {
  const firstSentenceEnd = description.indexOf('. ');
  return firstSentenceEnd === -1 ? description : description.slice(0, firstSentenceEnd + 1);
};

const certifications = (await getCollection('certifications')).sort(
  (a, b) => b.data.dateEarned.localeCompare(a.data.dateEarned),
);
const courses = await getCollection('courses');
const completedCourses = courses.filter((course) => course.data.status === 'completed');
const inProgressCourses = courses.filter((course) => course.data.status === 'in-progress');
const featuredCredential = certifications[0];
if (!featuredCredential) throw new Error('A certification is required for the homepage.');

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));

const railSections = [
  { id: 'home', number: '00', label: 'Homepage introduction' },
  { id: 'about', number: '01', label: 'About preview' },
  { id: 'projects', number: '02', label: 'Projects preview' },
  { id: 'credentials', number: '03', label: 'Credentials preview' },
];
---

<BaseLayout
  title="Ashton James D. Caspe | Portfolio"
  description="I'm Ashton James D. Caspe, a BS Information Technology student and aspiring web developer. Explore my work, credentials, and story."
  bodyClass="home-page"
>
  <section class="home-hero home-strip" id="home" aria-labelledby="home-heading" data-home-section>
    <div class="home-hero__video-shade" aria-hidden="true"></div>
    <div class="home-hero__grid" aria-hidden="true"></div>
    <div class="home-hero__copy" data-home-reveal="left">
      <h1 id="home-heading">
        <span>Ashton</span>
        <span>James D.</span>
        <span>Caspe</span>
      </h1>
      <p>{aboutEntry.data.tagline}</p>
      <PillButton href="#projects" label="Explore my work" tone="lime" />
    </div>

    <div class="home-hero__portrait" data-home-reveal="right">
      <CutFrame accent="lime" variant="double">
        <span class="home-hero__portrait-field" aria-hidden="true"></span>
        <img
          src={withBase('/assets/images/ashton-portrait.png')}
          alt="Ashton James D. Caspe wearing glasses and a black shirt."
          width="432"
          height="577"
          fetchpriority="high"
        />
      </CutFrame>
    </div>

    <a class="home-hero__next" href="#about" aria-label="Scroll to the About preview">
      <span>Scroll</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9.5 7 7 7-7" /></svg>
    </a>
  </section>

  <FilmStripDivider />

  <section class="home-about home-strip" id="about" aria-labelledby="about-preview-heading" data-home-section>
    <WatermarkWord word="About" tone="dark" />
    <div class="home-about__title" data-home-title>
      <SectionTitle label="About" number="01" tone="lime" />
    </div>

    <div class="home-about__portrait" data-home-reveal="left">
      <span class="home-about__portrait-halo" aria-hidden="true"></span>
      <Image
        src={aboutPortrait}
        alt="Ashton James D. Caspe wearing glasses and a black shirt."
        widths={[360, 540, 720]}
        sizes="(max-width: 48rem) 78vw, 42vw"
        loading="lazy"
      />
    </div>

    <div class="home-about__copy" data-home-reveal="right">
      <h2 id="about-preview-heading">I started with a game.</h2>
      <p class="home-about__story">{aboutEntry.data.story[0]}</p>
      <p class="home-about__education">{aboutEntry.data.education[0]}</p>
      <PillButton href={withBase('/about')} label="View my story" tone="black" />
    </div>
  </section>

  <FilmStripDivider />

  <section class="home-projects home-strip" id="projects" aria-labelledby="projects-preview-heading" data-home-section data-home-projects>
    <WatermarkWord word="Projects" tone="dark" />
    <div class="home-projects__title" data-home-title>
      <SectionTitle label="Projects" number="02" tone="lime" />
    </div>
    <h2 class="visually-hidden" id="projects-preview-heading">Project previews</h2>

    <div class="home-projects__stage">
      {projects.map((project, index) => (
        <article
          class="home-projects__panel"
          id={`home-project-panel-${project.data.slug}`}
          role="tabpanel"
          aria-labelledby={`home-project-tab-${project.data.slug}`}
          data-home-project-panel
          hidden={index !== 0}
        >
          <div class="home-projects__copy">
            <p class="home-projects__meta">{projectTypeLabels[project.data.type]} / {project.data.year}</p>
            <h3>{project.data.shortTitle}</h3>
            <p>{previewDescription(project.data.description)}</p>
            <PillButton href={withBase(`/projects/${project.data.slug}`)} label="View project" tone="lime" />
          </div>

          <div class="home-projects__media">
            <CutFrame accent="lime" variant="single">
              <Image
                src={project.data.cover.image}
                alt={project.data.cover.alt}
                widths={[720, 1080, 1440]}
                sizes="(max-width: 48rem) 100vw, 60vw"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </CutFrame>
          </div>
        </article>
      ))}
    </div>

    <div class="home-projects__switcher" role="tablist" aria-label="Choose a project" data-home-project-tabs>
      {projects.map((project, index) => (
        <button
          type="button"
          id={`home-project-tab-${project.data.slug}`}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`home-project-panel-${project.data.slug}`}
          tabindex={index === 0 ? 0 : -1}
          data-home-project-tab
        >
          {project.data.shortTitle}
        </button>
      ))}
    </div>
  </section>

  <FilmStripDivider />

  <section class="home-credentials home-strip" id="credentials" aria-labelledby="credentials-preview-heading" data-home-section>
    <WatermarkWord word="Certified" />
    <div class="home-credentials__title" data-home-title>
      <SectionTitle label="Credentials" number="03" tone="lime" />
    </div>

    <div class="home-credentials__copy" data-home-reveal="left">
      <h2 id="credentials-preview-heading">Certified and still learning.</h2>
      <p>{certifications.length} certifications and {completedCourses.length} completed Cisco courses, with {inProgressCourses.length} more in progress.</p>
      <PillButton href={withBase('/credentials')} label="View credentials" tone="black" />
    </div>

    <div class="home-credentials__certificate" data-home-reveal="right">
      <span class="home-credentials__stack home-credentials__stack--back" aria-hidden="true"></span>
      <span class="home-credentials__stack home-credentials__stack--middle" aria-hidden="true"></span>
      <CutFrame accent="black" variant="double">
        <Image
          src={featuredCredential.data.image}
          alt={`Certificate for ${featuredCredential.data.title}, earned by Ashton James D. Caspe.`}
          widths={[720, 1100, 1600]}
          sizes="(max-width: 48rem) 100vw, 58vw"
          loading="lazy"
        />
      </CutFrame>
      <div class="home-credentials__caption">
        <strong>{featuredCredential.data.title}</strong>
        <span>{formatDate(featuredCredential.data.dateEarned)}</span>
      </div>
    </div>
  </section>

  <SectionRail sections={railSections} totalNumber="03" />
</BaseLayout>

<script>
  import '../scripts/home-motion';
</script>

<style>
  :global(.home-page) { background: var(--color-black); }

  .home-strip {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 4.6rem);
    overflow: hidden;
    scroll-margin-top: 4.6rem;
  }

  .home-hero {
    display: grid;
    padding: clamp(3rem, 6vw, 6rem) var(--page-safe-end) clamp(4.5rem, 7vw, 7rem) var(--page-gutter);
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.8fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 5rem);
    color: var(--color-white);
  }

  .home-hero::before,
  .home-hero::after {
    position: absolute;
    z-index: -1;
    content: '';
    pointer-events: none;
  }

  .home-hero::before {
    inset: -18% 43% -18% -18%;
    background: rgb(0 0 0 / 0.91);
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .home-hero::after {
    top: -12%;
    right: 18%;
    width: clamp(5rem, 9vw, 10rem);
    height: 125%;
    background: var(--color-lime);
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .home-hero__video-shade {
    position: absolute;
    inset: 0;
    z-index: -3;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.38), rgb(0 0 0 / 0.1) 65%, rgb(0 0 0 / 0.55));
  }

  .home-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: repeating-linear-gradient(108deg, transparent 0, transparent 10px, rgb(255 255 255 / 0.035) 10px, rgb(255 255 255 / 0.035) 12px);
  }

  .home-hero__copy {
    position: relative;
    z-index: 3;
    width: min(100%, 51rem);
    margin-inline-start: max(0px, calc((100vw - var(--content-max)) / 2));
  }

  .home-hero h1 {
    display: grid;
    margin-bottom: var(--space-5);
    color: var(--color-white);
    font-size: clamp(3.75rem, 7vw, 7.6rem);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
    line-height: var(--leading-display-readable);
    text-transform: uppercase;
  }

  .home-hero h1 span { white-space: nowrap; }

  .home-hero h1 span:nth-child(2) { color: var(--color-lime); }

  .home-hero__copy > p {
    max-width: 34rem;
    margin-bottom: var(--space-6);
    color: var(--color-paper);
    font-size: clamp(1.05rem, 1rem + 0.55vw, 1.45rem);
    font-weight: 900;
  }

  .home-hero__portrait {
    position: relative;
    z-index: 2;
    width: min(100%, 36rem);
    justify-self: end;
    transform: rotate(1deg);
  }

  .home-hero__portrait :global(.cut-frame__media) {
    position: relative;
    min-height: clamp(29rem, 67vh, 44rem);
    background: var(--color-black);
  }

  .home-hero__portrait-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: repeating-linear-gradient(108deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 13px), var(--color-black);
  }

  .home-hero__portrait-field::after {
    position: absolute;
    bottom: 8%;
    left: -12%;
    width: 130%;
    height: 0.7rem;
    background: rgb(215 242 5 / 0.12);
    content: '';
    transform: rotate(-18deg);
  }

  .home-hero__portrait :global(img) {
    position: relative;
    z-index: 1;
    object-fit: contain;
    object-position: center bottom;
  }

  .home-hero__next {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    z-index: 4;
    display: grid;
    place-items: center;
    color: var(--color-white);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .home-hero__next svg { width: 1.9rem; margin-top: 0.25rem; }
  .home-hero__next path { fill: none; stroke: currentColor; stroke-linecap: square; stroke-linejoin: miter; stroke-width: 2.5; }

  .home-about {
    display: grid;
    min-height: clamp(43rem, 88svh, 57rem);
    padding: clamp(4rem, 7vw, 7rem) var(--page-safe-end) clamp(3rem, 6vw, 6rem) var(--page-gutter);
    grid-template-columns: minmax(20rem, 0.9fr) minmax(22rem, 0.85fr);
    grid-template-rows: auto 1fr;
    align-items: center;
    column-gap: clamp(2rem, 7vw, 9rem);
    row-gap: var(--space-6);
    background: var(--color-paper);
  }

  .home-about::before {
    position: absolute;
    inset: -20% 48% -20% -20%;
    z-index: -2;
    background: repeating-linear-gradient(108deg, rgb(255 255 255 / 0.04) 0 3px, transparent 3px 11px), var(--color-black);
    content: '';
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .home-about::after {
    position: absolute;
    right: -12%;
    bottom: -10%;
    z-index: -1;
    width: 74%;
    height: 18%;
    background: var(--color-lime);
    content: '';
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .home-about :global(.watermark) { top: 0.04em; left: -0.07em; color: rgb(255 255 255 / 0.1); }

  .home-about__title,
  .home-projects__title,
  .home-credentials__title {
    position: relative;
    z-index: 4;
    grid-column: 1 / -1;
    grid-row: 1;
    align-self: start;
  }

  .home-about__title :global(.section-title),
  .home-projects__title :global(.section-title),
  .home-credentials__title :global(.section-title) {
    min-height: clamp(10rem, 13vw, 13rem);
    padding-block: clamp(2rem, 3vw, 2.75rem);
  }

  @media (min-width: 48.0625rem) {
    .home-about__title :global(.section-title),
    .home-projects__title :global(.section-title),
    .home-credentials__title :global(.section-title) {
      height: 11rem;
      min-height: 11rem;
      padding-block: 1.25rem;
    }

    .home-about__title :global(.section-title__label),
    .home-projects__title :global(.section-title__label),
    .home-credentials__title :global(.section-title__label) {
      font-size: var(--step-1);
    }

    .home-about__title :global(.section-title__number),
    .home-projects__title :global(.section-title__number),
    .home-credentials__title :global(.section-title__number) {
      font-size: 7rem;
    }
  }

  .home-about__portrait {
    position: relative;
    z-index: 2;
    width: min(100%, 39rem);
    margin-top: 0;
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    justify-self: center;
  }

  .home-about__portrait-halo {
    position: absolute;
    inset: 16% -5% 2% 9%;
    z-index: -1;
    background: var(--color-lime);
    clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
  }

  .home-about__portrait :global(img) {
    width: 100%;
    max-height: 45rem;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(1rem 1rem 0 rgb(0 0 0 / 0.2));
  }

  .home-about__copy {
    position: relative;
    z-index: 2;
    width: min(100%, 39rem);
    padding: clamp(1.5rem, 3vw, 3rem);
    border-left: 0.65rem solid var(--color-lime);
    background: var(--color-white);
    box-shadow: var(--shadow-hard);
    grid-column: 2;
    grid-row: 2;
  }

  .home-about h2,
  .home-projects h3,
  .home-credentials h2 {
    margin-bottom: var(--space-4);
    font-size: clamp(2.8rem, 4.2vw, 5.4rem);
    font-style: italic;
    letter-spacing: var(--tracking-display-readable);
    line-height: var(--leading-display-readable);
    text-transform: uppercase;
  }

  .home-about__story { margin-bottom: var(--space-5); color: var(--color-text); }

  .home-about__education {
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-border);
    color: var(--color-black);
    font-size: var(--step--1);
    font-weight: 900;
  }

  .home-projects {
    display: grid;
    min-height: calc(100svh - 4.6rem);
    padding: clamp(4rem, 6vw, 6rem) var(--page-safe-end) clamp(4rem, 6vw, 6rem) var(--page-gutter);
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: var(--space-6);
    background: repeating-linear-gradient(108deg, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 11px), var(--color-black);
    color: var(--color-white);
  }

  .home-projects::before {
    display: none;
  }

  .home-projects :global(.watermark) { top: 1.1em; right: -0.08em; color: rgb(255 255 255 / 0.1); }
  .home-projects__stage { position: relative; z-index: 2; min-width: 0; grid-row: 2; }

  .home-projects__panel {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(27rem, 1.28fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
  }

  .home-projects__panel[hidden] { display: none; }

  .home-projects__copy { position: relative; z-index: 3; min-width: 0; grid-column: 1; }

  .home-projects__meta {
    margin-bottom: var(--space-3);
    color: var(--color-lime);
    font-size: var(--step--1);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-projects h3 {
    max-width: 100%;
    color: var(--color-lime);
    font-size: clamp(2.1rem, 3.15vw, 3.9rem);
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .home-projects__copy > p:not(.home-projects__meta) {
    max-width: 43ch;
    margin-bottom: var(--space-6);
    color: var(--color-paper);
    font-weight: 700;
  }

  .home-projects__media {
    position: relative;
    z-index: 2;
    width: min(100%, 62rem);
    grid-column: 2;
  }

  .home-projects__media :global(.cut-frame__media) {
    height: clamp(20rem, 23vw, 23rem);
    min-height: 0;
    background: var(--color-black);
  }

  .home-projects__media :global(img) {
    object-fit: contain;
    object-position: center;
    background: var(--color-black);
  }

  .home-projects__switcher {
    position: relative;
    z-index: 3;
    display: grid;
    min-width: 0;
    grid-row: 3;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .home-projects__switcher button {
    display: flex;
    min-width: 0;
    padding: 0.85rem 0;
    align-items: baseline;
    border: 0;
    border-bottom: 0.2rem solid var(--color-surface-raised);
    background: transparent;
    color: var(--color-muted-on-dark);
    font-size: var(--step--1);
    font-weight: 900;
    text-align: left;
    cursor: pointer;
  }

  .home-projects__switcher button[aria-selected='true'] { border-color: var(--color-lime); color: var(--color-white); }

  .home-projects__switcher button:focus-visible {
    outline: 0.18rem solid var(--color-lime);
    outline-offset: 0.3rem;
  }

  .home-credentials {
    display: grid;
    min-height: auto;
    padding: clamp(4rem, 6vw, 6rem) var(--page-safe-end) clamp(2.5rem, 3.5vw, 3.75rem) var(--page-gutter);
    grid-template-columns: minmax(19rem, 0.7fr) minmax(27rem, 1.3fr);
    grid-template-rows: auto 1fr;
    align-items: center;
    column-gap: clamp(2rem, 5vw, 6rem);
    row-gap: var(--space-6);
    background: var(--color-paper);
  }

  .home-credentials::before,
  .home-credentials::after {
    position: absolute;
    z-index: -1;
    background: repeating-linear-gradient(108deg, rgb(255 255 255 / 0.045) 0 3px, transparent 3px 11px), var(--color-black);
    content: '';
    transform: skewX(calc(var(--shape-angle) * -1));
  }

  .home-credentials::before { inset: -18% 55% 79% -18%; }
  .home-credentials::after { inset: 83% -18% -18% 30%; }
  .home-credentials :global(.watermark) { top: 0.5em; right: -0.08em; }

  .home-credentials__copy { position: relative; z-index: 3; grid-column: 1; grid-row: 2; }

  .home-credentials__copy > p {
    max-width: 28rem;
    margin-bottom: var(--space-4);
    color: var(--color-text);
    font-size: var(--step-1);
  }

  .home-credentials__certificate {
    position: relative;
    z-index: 2;
    width: min(100%, 64rem);
    grid-column: 2;
    grid-row: 2;
    transform: rotate(-1deg);
  }

  .home-credentials__stack {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 0.35rem solid var(--color-black);
    background: var(--color-surface-raised);
    clip-path: polygon(0 0, calc(100% - 4rem) 0, 100% 4rem, 100% 100%, 4rem 100%, 0 calc(100% - 4rem));
  }

  .home-credentials__stack--back { transform: translate(2.2rem, -2rem) rotate(3deg); }
  .home-credentials__stack--middle { background: var(--color-border); transform: translate(1rem, -1rem) rotate(1deg); }

  .home-credentials__certificate :global(.cut-frame__media) { min-height: clamp(20rem, 31vw, 31rem); background: var(--color-white); }
  .home-credentials__certificate :global(img) { object-fit: contain; object-position: center; background: var(--color-white); }

  .home-credentials__caption {
    display: flex;
    width: min(92%, 50rem);
    margin-inline: auto;
    padding: 0.85rem 1.15rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background: var(--color-black);
    color: var(--color-white);
    font-size: var(--step--1);
  }

  .home-credentials__caption span { flex: none; color: var(--color-lime); font-weight: 900; }

  @media (max-width: 68rem) {
    .home-hero { grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr); }
    .home-about { grid-template-columns: minmax(18rem, 0.75fr) minmax(20rem, 1fr); gap: var(--space-7); }
