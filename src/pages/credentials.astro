---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialCard from '../components/CredentialCard.astro';
import CredentialViewer from '../components/CredentialViewer.astro';
import DiagonalBands from '../components/DiagonalBands.astro';
import FilmStripDivider from '../components/FilmStripDivider.astro';
import PillTabs from '../components/PillTabs.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WatermarkWord from '../components/WatermarkWord.astro';

const certifications = (await getCollection('certifications')).sort(
  (a, b) => b.data.dateEarned.localeCompare(a.data.dateEarned),
);
const courses = (await getCollection('courses')).sort((a, b) => {
  if (a.data.status !== b.data.status) return a.data.status === 'in-progress' ? -1 : 1;
  return b.data.dateCompleted.localeCompare(a.data.dateCompleted);
});

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(`${value}T00:00:00Z`));

const splitModule = (module: string) => {
  const match = module.match(/^(.*) \(([^()]*)\)$/);
  return match ? { name: match[1], date: match[2] } : { name: module, date: undefined };
};

const summarizeModuleDates = (dates: Array<string | undefined>) => {
  const uniqueDates = [...new Set(dates.filter((date): date is string => Boolean(date)))];
  if (uniqueDates.length === 0) return undefined;
  if (uniqueDates.length === 1) return uniqueDates[0];

  const first = uniqueDates[0];
  const last = uniqueDates[uniqueDates.length - 1];
  const lastYear = last.match(/, (\d{4})$/)?.[1];
  const firstWithoutSharedYear = lastYear && first.endsWith(`, ${lastYear}`)
    ? first.slice(0, -`, ${lastYear}`.length)
    : first;
  return `${firstWithoutSharedYear}–${last}`;
};

const certificationItems = certifications.map((entry) => ({
  kind: 'Certification' as const,
  title: entry.data.title,
  provider: entry.data.issuer,
  dateLabel: formatDate(entry.data.dateEarned),
  status: 'completed' as const,
  certificateImage: entry.data.image,
  badgeImage: entry.data.badgeImage,
  verifyUrl: entry.data.verifyUrl,
}));

const courseItems = courses.map((entry) => {
  const modules = entry.data.modules?.map(splitModule);
  return {
    kind: 'Course completion' as const,
    title: entry.data.title,
    provider: entry.data.provider,
    dateLabel: entry.data.status === 'completed' ? formatDate(entry.data.dateCompleted) : 'In progress',
    status: entry.data.status,
    certificateImage: entry.data.status === 'completed' ? entry.data.certificate.image : undefined,
    badgeImage: entry.data.badgeImage,
    verifyUrl: entry.data.verifyUrl,
    pdfUrl: entry.data.status === 'completed' ? entry.data.certificate.pdf : undefined,
    modules: modules?.map((module) => module.name),
    moduleDateLabel: summarizeModuleDates(modules?.map((module) => module.date) ?? []),
  };
});

const viewerItems = [...certificationItems, ...courseItems];
const tabs = [
  { label: 'Certifications', value: 'certifications', controls: 'certifications-panel' },
  { label: 'Course Completions', value: 'courses', controls: 'courses-panel' },
];
---

<BaseLayout
  title="Credentials | Ashton Caspe"
  description="Professional certifications and course completions earned by Ashton James D. Caspe."
  backgroundVideo={false}
  bodyClass="credentials-page"
>
  <section class="credentials-hero" aria-labelledby="credentials-heading">
    <DiagonalBands variant="split" />
    <div class="credentials-hero__title">
      <SectionTitle label="Credentials" number="03" tone="lime" />
    </div>
    <div class="credentials-hero__copy">
      <p class="credentials-hero__lead" id="credentials-heading">
        Certifications and completed courses, each with its certificate and a link to verify it.
      </p>
    </div>
  </section>

  <FilmStripDivider />

  <section class="credentials-library" aria-labelledby="credentials-library-heading" data-credentials-library>
    <WatermarkWord word="Credentials" />
    <div class="credentials-library__head">
      <div>
        <p class="credentials-library__eyebrow">Verified learning / 2024–2026</p>
        <h1 id="credentials-library-heading">Credential archive</h1>
      </div>
      <PillTabs id="credential-tabs" label="Choose credential type" items={tabs} active="certifications" />
    </div>

    <p class="credentials-library__count" aria-live="polite" data-credential-count>
      {certifications.length} certifications
    </p>

    <div
      class="credential-grid"
      id="certifications-panel"
      role="tabpanel"
      aria-labelledby="credential-tabs-certifications-tab"
      data-credential-panel="certifications"
      data-credential-kind="Certification"
    >
      {certificationItems.map((item, index) => (
        <CredentialCard
          viewerIndex={index}
          cardIndex={index}
          kind={item.kind}
          title={item.title}
          provider={item.provider}
          dateLabel={item.dateLabel}
          image={item.certificateImage}
          badgeImage={item.badgeImage}
          eager={index < 3}
        />
      ))}
    </div>

    <div
      class="credential-grid"
      id="courses-panel"
      role="tabpanel"
      aria-labelledby="credential-tabs-courses-tab"
      data-credential-panel="courses"
      data-credential-kind="Course completion"
      hidden
    >
      {courseItems.map((item, index) => (
        <CredentialCard
          viewerIndex={certificationItems.length + index}
          cardIndex={index}
          kind={item.kind}
          title={item.title}
          provider={item.provider}
          dateLabel={item.dateLabel}
          image={item.certificateImage}
          badgeImage={item.badgeImage}
          status={item.status}
        />
      ))}
    </div>
  </section>

  <CredentialViewer items={viewerItems} />
</BaseLayout>

<script>
  let cleanUpCredentialTabs = () => {};

  const setupCredentialTabs = () => {
    cleanUpCredentialTabs();
    const library = document.querySelector<HTMLElement>('[data-credentials-library]');
    if (!library) return;

    const tabList = library.querySelector<HTMLElement>('[data-pill-tabs]');
    const panels = [...library.querySelectorAll<HTMLElement>('[data-credential-panel]')];
    const count = library.querySelector<HTMLElement>('[data-credential-count]');

    const selectPanel = (value: string) => {
      panels.forEach((panel) => { panel.hidden = panel.dataset.credentialPanel !== value; });
      const visible = panels.find((panel) => !panel.hidden);
      const total = visible?.children.length ?? 0;
      if (count) count.textContent = value === 'certifications'
        ? `${total} certification${total === 1 ? '' : 's'}`
        : `${total} course${total === 1 ? '' : 's'} shown`;
    };

    const changeHandler = (event: Event) => {
      selectPanel((event as CustomEvent<{ value: string }>).detail.value);
    };
    tabList?.addEventListener('pill-tab-change', changeHandler);
    cleanUpCredentialTabs = () => tabList?.removeEventListener('pill-tab-change', changeHandler);
  };

  document.addEventListener('astro:page-load', setupCredentialTabs);
  setupCredentialTabs();
</script>

<style>
  :global(.credentials-page) {
    background: var(--color-paper);
  }

  .credentials-hero {
    position: relative;
    display: grid;
    min-height: clamp(31rem, 67vh, 45rem);
    padding: clamp(3rem, 7vw, 6.5rem) var(--page-safe-end) clamp(4rem, 8vw, 7rem) var(--page-gutter);
    grid-template-columns: minmax(18rem, 0.9fr) minmax(20rem, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    isolation: isolate;
    overflow: hidden;
  }

  .credentials-hero__title {
    align-self: start;
  }

  .credentials-hero__copy {
    position: relative;
    z-index: 2;
    width: 100%;
    min-width: 0;
    max-width: 44rem;
    padding: clamp(1.5rem, 3vw, 3rem);
    border-left: 0.65rem solid var(--color-lime);
    background: var(--color-paper);
  }

  .credentials-hero__copy p:last-child {
    max-width: 55ch;
    margin-bottom: 0;
  }

  .credentials-hero__lead {
    margin-bottom: var(--space-5);
    color: var(--color-black);
    font-size: clamp(1.7rem, 1.2rem + 2vw, 3.5rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .credentials-library {
    position: relative;
    min-height: 52rem;
    padding: clamp(5rem, 9vw, 9rem) var(--page-safe-end) clamp(6rem, 10vw, 10rem) var(--page-gutter);
    overflow: hidden;
    background: var(--color-paper);
  }

  .credentials-library :global(.watermark) {
    top: 2.7rem;
    right: -0.08em;
  }

  .credentials-library__head,
  .credentials-library__count,
  .credential-grid {
    position: relative;
    z-index: 1;
    width: min(100%, var(--content-max));
    margin-inline: auto;
  }

  .credentials-library__head {
    display: flex;
    margin-bottom: var(--space-4);
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .credentials-library__eyebrow {
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 0;
    font-size: clamp(2.7rem, 2rem + 3vw, 5.7rem);
    font-style: italic;
    text-transform: uppercase;
  }

  .credentials-library__count {
    margin-bottom: var(--space-7);
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .credential-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3.5rem, 6vw, 6rem) clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .credential-grid[hidden] {
    display: none;
  }

  @media (max-width: 75rem) {
    .credentials-library__head {
      align-items: start;
      flex-direction: column;
    }

    .credential-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .credentials-hero {
      min-height: auto;
      padding-top: var(--space-7);
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .credentials-hero__copy {
      padding: var(--space-5);
    }

    .credentials-hero__lead {
      font-size: clamp(1.55rem, 7.2vw, 2.15rem);
    }

    .credentials-library {
      padding-top: var(--space-9);
    }

    .credential-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
